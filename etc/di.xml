<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Kingletas\CacheVary\Api\VaryPolicyInterface"
                type="Kingletas\CacheVary\Model\Vary\VaryPolicy"/>
    <preference for="Kingletas\CacheVary\Api\VaryHasherInterface"
                type="Kingletas\CacheVary\Model\Vary\ContextVaryHasher"/>
    <preference for="Kingletas\CacheVary\Api\PolicyGuardInterface"
                type="Kingletas\CacheVary\Model\Vary\PolicyGuard"/>
    <!--
        Reads the schema rather than any Adobe Commerce class, so it loads on Open
        Source and reports itself unavailable there. Swap in NoSegmentSource to
        switch the coverage check off.
    -->
    <preference for="Kingletas\CacheVary\Api\CacheRelevantSegmentsInterface"
                type="Kingletas\CacheVary\Model\Segment\SchemaSegmentSource"/>
    <preference for="Kingletas\CacheVary\Api\WebsiteResolverInterface"
                type="Kingletas\CacheVary\Model\Store\StoreWebsiteResolver"/>

    <!--
        The config section id is an argument, not a constant, which is what
        makes the module rebrandable: bin/rebrand rewrites this one string.
    -->
    <type name="Kingletas\CacheVary\Model\Config">
        <arguments>
            <argument name="section" xsi:type="string">kingletas_cachevary</argument>
        </arguments>
    </type>

    <!--
        Adobe Commerce puts the customer's whole segment set into the cache
        key, so N active segments split every cacheable page up to 2^N ways.
        The allowlist names the segments that genuinely change cacheable HTML;
        everything else collapses into one bucket.
    -->
    <virtualType name="Kingletas\CacheVary\Model\Vary\Rule\CustomerSegmentAllowlist"
                 type="Kingletas\CacheVary\Model\Vary\Rule\AllowlistedValues">
        <arguments>
            <argument name="key" xsi:type="string">customer_segment</argument>
            <argument name="configPath" xsi:type="string">policy/cacheable_customer_segments</argument>
        </arguments>
    </virtualType>

    <!--
        Which caching applications this policy may rewrite the key for, by
        `system/full_page_cache/caching_application`. Varnish only, because that
        is the one it was measured against; the built-in cache keys through a
        different identifier and is Magento's shipped default. Fastly is 42 and
        is Varnish underneath, so a Fastly store adds it here deliberately.
    -->
    <type name="Kingletas\CacheVary\Model\Vary\PolicyGuard">
        <arguments>
            <argument name="cachingApplications" xsi:type="array">
                <item name="varnish" xsi:type="number">2</item>
            </argument>
            <!--
                Keys that say who the shopper is. A rule naming one of these takes
                the whole policy out of force rather than merging pricing tiers.
            -->
            <argument name="protectedKeys" xsi:type="array">
                <item name="customer_group" xsi:type="string">customer_group</item>
                <item name="customer_logged_in" xsi:type="string">customer_logged_in</item>
            </argument>
        </arguments>
    </type>

    <!-- Must name the same key as the rule above, or the coverage check reports on nothing. -->
    <type name="Kingletas\CacheVary\Model\Segment\SchemaSegmentSource">
        <arguments>
            <argument name="contextKey" xsi:type="string">customer_segment</argument>
        </arguments>
    </type>

    <type name="Kingletas\CacheVary\Model\Vary\VaryPolicy">
        <arguments>
            <argument name="rules" xsi:type="array">
                <item name="customer_segment" xsi:type="object">Kingletas\CacheVary\Model\Vary\Rule\CustomerSegmentAllowlist</item>
            </argument>
        </arguments>
    </type>

    <!-- The command name is wiring, so `bin/rebrand` rewrites it with the rest. -->
    <type name="Kingletas\CacheVary\Console\Command\ShowPolicyCommand">
        <arguments>
            <argument name="name" xsi:type="string">kingletas:cache-vary:policy</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="kingletas_cache_vary_policy" xsi:type="object">Kingletas\CacheVary\Console\Command\ShowPolicyCommand</item>
            </argument>
        </arguments>
    </type>

</config>
